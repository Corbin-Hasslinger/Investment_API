{
  "name": "Atlas API Development",
  "dockerComposeFile": "compose.yaml",
  "service": "dev",
  "workspaceFolder": "/workspaces/atlas-api",
  "shutdownAction": "stopCompose",

  "forwardPorts": [8000, 4200],

  "portsAttributes": {
    "8000": {
      "label": "FastAPI"
    },
    "4200": {
      "label": "Angular"
    }
  },
  "features": {
  "ghcr.io/devcontainers/features/node:2.1.0": {
    "version": "24"
  }
  },
  
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.defaultInterpreterPath": "/workspaces/atlas-api/.venv/bin/python",
        "python.analysis.extraPaths": [
          "/workspaces/atlas-api/src"
        ],
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "files.exclude": {
          "**/__pycache__": true,
          "**/.pytest_cache": true,
          "**/.ruff_cache": true
        },
        "search.exclude": {
          "**/.venv": true,
          "**/__pycache__": true,
          "**/.pytest_cache": true,
          "**/.ruff_cache": true
        }
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml",
        "ms-azuretools.vscode-docker"
      ]
    }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "root"
}